[Unit]
Description=moOde MQTT bridge
# mpd is only a soft dependency: the bridge reconnects on its own and must keep
# publishing display state even when MPD is down.
After=network-online.target mpd.service
Wants=network-online.target

[Service]
Type=simple
# www-data, the web server user: the sqlite DB is owned by www-data, so running
# as root would leave root-owned journal files behind. Nothing the bridge does
# needs privilege - not even reading the screen state.
User=www-data
Group=www-data
ExecStart=/usr/local/lib/moode-mqtt/moode-mqtt.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
