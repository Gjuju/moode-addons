# moode-mqtt configuration - copy to moode-mqtt.conf and fill in.
# Gitignored: it holds broker credentials. install.sh deploys it to
# /etc/moode-mqtt.conf. Every key is explained in install.md.
#
# No comment at the end of a value line - it becomes part of the value.

[broker]
host = 192.168.1.x
port = 1883
username =
password =

# One connection per client id: give each box its own.
client_id = moode-mqtt

[moode]
# Used in every topic and as the Home Assistant device id. Pick it once:
# changing it later creates a second device.
instance = moode
friendly_name = moOde

topic_prefix = moode
discovery_prefix = homeassistant

# Display and ALSA sampling, in seconds. MPD changes do not wait for it.
poll_interval = 1.0

# Seconds the output must stay closed before "Audio active" goes off. MPD
# closes it between tracks. This is not the amp-off delay - keep that in the
# Home Assistant automation.
audio_off_delay = 5.0

# Step for a bare "up" / "dn" on cmd/volume.
volume_step = 5

# Detected on its own. Set it only for a reverse proxy or a special case.
#web_base_url = http://192.168.1.x

# The only thing reaching outside your network: one GET every 12 h.
update_check = yes

mpd_host = localhost
mpd_port = 6600
