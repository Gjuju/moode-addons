# moode-mqtt configuration - copy to moode-mqtt.conf and fill in.
#
# moode-mqtt.conf is gitignored: it holds broker credentials and must never be
# committed. install.sh deploys it to /etc/moode-mqtt.conf as 0640 root:www-data.

[broker]
host = 192.168.1.x
port = 1883
username =
password =
client_id = moode-mqtt

[moode]
# Instance id: used in every topic and as the Home Assistant device identifier.
# Changing it later creates a second device in HA, so pick it once.
instance = moode
friendly_name = moOde

topic_prefix = moode
discovery_prefix = homeassistant

# How often the display and ALSA state are sampled, in seconds. MPD changes do
# not wait for this: the idle connection wakes the publisher immediately.
poll_interval = 1.0

# Seconds the ALSA output has to stay closed before "Audio active" goes off.
# MPD closes the device between tracks, so this must be a few seconds at least.
# This is NOT the amp-off delay - hold that one in the Home Assistant automation
# with `for:`, where it is easy to change.
audio_off_delay = 5.0

# Default step for a bare "up" / "dn" payload on cmd/volume.
volume_step = 5

# Base URL of this box's web server, used to make AirPlay artwork reachable: its
# cache stores a path relative to the web root, not an absolute URL like Spotify
# and Qobuz do. Leave empty and it is detected - the address this box uses to
# reach the broker, which is the one Home Assistant will reach too, even with
# Ethernet and Wi-Fi both up. Set it only for a reverse proxy or a special case.
web_base_url =

# Check once every 12 h whether a newer moode-mqtt has been published, and expose
# the answer as a Home Assistant binary sensor. This is the only thing that
# reaches outside your network: one plain GET of a version file. Set to no to
# disable it entirely.
update_check = yes

mpd_host = localhost
mpd_port = 6600
